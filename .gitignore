# ══════════════════════════════════════════════════════════════════════════════
# corpsec-ops-platform — gitignore
# ══════════════════════════════════════════════════════════════════════════════

# Secrets — never commit
.env
.env.local
.env.*.local
secrets/
*.key
*.pem
*.pfx
*.p12

# Generated certificates
certs/*.crt
certs/*.key
certs/*.csr
certs/*.srl
!certs/generate-certs.sh

# Compliance evidence (sensitive — collected at runtime)
compliance/evidence/
!compliance/evidence/.gitkeep

# Docker volumes (data)
data/
volumes/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Wazuh agent logs (large)
wazuh/logs/

# n8n local data
n8n/data/

# Ansible
ansible/*.retry
ansible/.vault_password

# OS
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Screenshots — keep tracked but ignore work-in-progress
screenshots/**/*.tmp.png
screenshots/**/_drafts/

# Trial credentials (NEVER commit)
trial-credentials.txt
api-keys.txt
