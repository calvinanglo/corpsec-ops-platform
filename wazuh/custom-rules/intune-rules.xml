<!-- ════════════════════════════════════════════════════════════════════════════
     corpsec-ops-platform — Microsoft Intune detection rules
     Source: Microsoft Graph API (streamed by integrations/intune/device_streamer.py)
     ════════════════════════════════════════════════════════════════════════════ -->
<group name="intune,mdm,corpsec,">

  <rule id="100600" level="3">
    <decoded_as>json</decoded_as>
    <field name="source">intune</field>
    <description>Intune: $(activityType) on device $(device.deviceName)</description>
    <options>no_full_log</options>
  </rule>

  <!-- ── Device enrollment ────────────────────────────────────────────────── -->
  <rule id="100601" level="5">
    <if_sid>100600</if_sid>
    <field name="activityType">enrollment</field>
    <field name="result">success</field>
    <description>Intune: Device $(device.deviceName) enrolled by $(user.userPrincipalName)</description>
  </rule>

  <rule id="100602" level="8">
    <if_sid>100600</if_sid>
    <field name="activityType">enrollment</field>
    <field name="result">failure</field>
    <description>Intune: Enrollment failure for $(user.userPrincipalName) - $(failureReason)</description>
  </rule>

  <rule id="100603" level="10">
    <if_sid>100600</if_sid>
    <field name="activityType">unenrollment</field>
    <description>Intune: Device $(device.deviceName) unenrolled - check for tampering</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <!-- ── Compliance status ────────────────────────────────────────────────── -->
  <rule id="100610" level="9">
    <if_sid>100600</if_sid>
    <field name="complianceState">noncompliant</field>
    <description>Intune: Device $(device.deviceName) non-compliant - user $(user.userPrincipalName)</description>
    <group>compliance_violation,</group>
  </rule>

  <rule id="100611" level="11">
    <if_sid>100600</if_sid>
    <field name="complianceState">noncompliant</field>
    <field name="noncomplianceReason">jailbroken|rooted</field>
    <description>Intune: JAILBROKEN/ROOTED device for $(user.userPrincipalName) - $(device.deviceName)</description>
    <mitre>
      <id>T1611</id>
    </mitre>
  </rule>

  <rule id="100612" level="10">
    <if_sid>100600</if_sid>
    <field name="complianceState">noncompliant</field>
    <field name="noncomplianceReason">no_encryption</field>
    <description>Intune: BitLocker/FileVault disabled on $(device.deviceName) - $(user.userPrincipalName)</description>
  </rule>

  <rule id="100613" level="9">
    <if_sid>100600</if_sid>
    <field name="complianceState">noncompliant</field>
    <field name="noncomplianceReason">os_version_below_minimum</field>
    <description>Intune: Out-of-date OS on $(device.deviceName) - patch level violation</description>
    <mitre>
      <id>T1499</id>
    </mitre>
  </rule>

  <!-- ── Conditional Access ───────────────────────────────────────────────── -->
  <rule id="100620" level="10">
    <if_sid>100600</if_sid>
    <field name="conditionalAccessStatus">failure</field>
    <description>Intune CA: Access blocked for $(user.userPrincipalName) - $(failureReason)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100621" level="12">
    <if_sid>100600</if_sid>
    <field name="conditionalAccessStatus">failure</field>
    <field name="failureReason">noncompliant_device</field>
    <description>Intune CA: Non-compliant device blocked from sign-in - $(user.userPrincipalName)</description>
    <group>conditional_access_block,</group>
  </rule>

  <!-- ── App protection ───────────────────────────────────────────────────── -->
  <rule id="100630" level="8">
    <if_sid>100600</if_sid>
    <field name="activityType">app_protection_violation</field>
    <description>Intune: App protection policy violation by $(user.userPrincipalName) - $(app.displayName)</description>
  </rule>

  <rule id="100631" level="11">
    <if_sid>100600</if_sid>
    <field name="activityType">app_data_wipe</field>
    <description>Intune: App data wipe initiated for $(user.userPrincipalName) - $(device.deviceName)</description>
  </rule>

  <!-- ── Remote actions ───────────────────────────────────────────────────── -->
  <rule id="100640" level="11">
    <if_sid>100600</if_sid>
    <field name="activityType">retire_device</field>
    <description>Intune: Device retired - $(device.deviceName) by $(actor.userPrincipalName)</description>
  </rule>

  <rule id="100641" level="13">
    <if_sid>100600</if_sid>
    <field name="activityType">wipe_device</field>
    <description>Intune: REMOTE WIPE issued for $(device.deviceName) by $(actor.userPrincipalName)</description>
  </rule>

  <!-- ── Configuration drift ──────────────────────────────────────────────── -->
  <rule id="100650" level="10">
    <if_sid>100600</if_sid>
    <field name="activityType">configuration_profile_unassign</field>
    <description>Intune: Configuration profile unassigned by $(actor.userPrincipalName) - $(profile.displayName)</description>
    <mitre>
      <id>T1562</id>
    </mitre>
  </rule>

  <rule id="100651" level="10">
    <if_sid>100600</if_sid>
    <field name="activityType">compliance_policy_delete</field>
    <description>Intune: Compliance policy DELETED by $(actor.userPrincipalName) - $(policy.displayName)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

</group>
