<!-- ════════════════════════════════════════════════════════════════════════════
     corpsec-ops-platform — 1Password Business detection rules
     Source: 1Password Events API (streamed by integrations/onepassword/audit_log_streamer.py)
     Event types: signin, item_usage, audit_event
     ════════════════════════════════════════════════════════════════════════════ -->
<group name="onepassword,1password,corpsec,">

  <rule id="100500" level="3">
    <decoded_as>json</decoded_as>
    <field name="source">onepassword</field>
    <description>1Password: $(action) by $(actor_uuid)</description>
    <options>no_full_log</options>
  </rule>

  <!-- ── Sign-in events ───────────────────────────────────────────────────── -->
  <rule id="100501" level="5">
    <if_sid>100500</if_sid>
    <field name="category">signin</field>
    <field name="action">failed</field>
    <description>1Password: Sign-in failure for $(target_user.email) from $(client.ip_address)</description>
  </rule>

  <rule id="100502" level="10" frequency="3" timeframe="300">
    <if_matched_sid>100501</if_matched_sid>
    <same_field>target_user.email</same_field>
    <description>1Password: Brute force - 3+ sign-in failures for $(target_user.email)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100503" level="11">
    <if_sid>100500</if_sid>
    <field name="category">signin</field>
    <field name="action">success</field>
    <field name="target_user.country">!CA,!US</field>
    <description>1Password: Sign-in from unusual country - $(target_user.email) from $(client.country)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- ── Vault access ─────────────────────────────────────────────────────── -->
  <rule id="100510" level="7">
    <if_sid>100500</if_sid>
    <field name="action">view</field>
    <field name="object_type">item</field>
    <description>1Password: Item viewed by $(actor.email) - $(object.title) in vault $(vault.name)</description>
  </rule>

  <rule id="100511" level="10" frequency="20" timeframe="600">
    <if_matched_sid>100510</if_matched_sid>
    <same_field>actor.email</same_field>
    <description>1Password: Bulk vault access - 20+ items viewed by $(actor.email) in 10 minutes</description>
    <mitre>
      <id>T1552.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <rule id="100512" level="11">
    <if_sid>100500</if_sid>
    <field name="action">export</field>
    <description>1Password: Vault export by $(actor.email) - $(vault.name)</description>
    <mitre>
      <id>T1555</id>
    </mitre>
    <group>data_exfiltration,</group>
  </rule>

  <!-- ── Permission changes ───────────────────────────────────────────────── -->
  <rule id="100520" level="8">
    <if_sid>100500</if_sid>
    <field name="action">grant</field>
    <field name="object_type">vault_permission</field>
    <description>1Password: Vault permission granted by $(actor.email) - $(target_user.email) → $(vault.name)</description>
  </rule>

  <rule id="100521" level="10">
    <if_sid>100500</if_sid>
    <field name="action">grant</field>
    <field name="object_type">vault_permission</field>
    <field name="permission">manage</field>
    <description>1Password: Vault MANAGE permission granted to $(target_user.email) - audit access</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- ── Service account abuse ────────────────────────────────────────────── -->
  <rule id="100530" level="8">
    <if_sid>100500</if_sid>
    <field name="action">create</field>
    <field name="object_type">service_account</field>
    <description>1Password: New service account created by $(actor.email) - $(object.name)</description>
  </rule>

  <rule id="100531" level="11">
    <if_sid>100500</if_sid>
    <field name="action">create</field>
    <field name="object_type">service_account_token</field>
    <description>1Password: Service account token created by $(actor.email) - long-lived API access</description>
  </rule>

  <!-- ── User lifecycle ───────────────────────────────────────────────────── -->
  <rule id="100540" level="6">
    <if_sid>100500</if_sid>
    <field name="action">invite</field>
    <field name="object_type">user</field>
    <description>1Password: User invited by $(actor.email) - $(target_user.email)</description>
  </rule>

  <rule id="100541" level="9">
    <if_sid>100500</if_sid>
    <field name="action">delete</field>
    <field name="object_type">user</field>
    <description>1Password: User deleted by $(actor.email) - $(target_user.email)</description>
  </rule>

  <!-- ── Watchtower / breach alerts ────────────────────────────────────────── -->
  <rule id="100550" level="11">
    <if_sid>100500</if_sid>
    <field name="category">watchtower</field>
    <field name="action">breached_password</field>
    <description>1Password: Watchtower - breached password detected for $(actor.email)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

</group>
