<!-- ════════════════════════════════════════════════════════════════════════════
     corpsec-ops-platform — Google Workspace detection rules
     Source: GWS Reports API (streamed by integrations/google_workspace/audit_log_streamer.py)
     Application types: login, admin, drive, gmail, oauth_token, mobile, groups
     ════════════════════════════════════════════════════════════════════════════ -->
<group name="google_workspace,gws,corpsec,">

  <rule id="100400" level="3">
    <decoded_as>json</decoded_as>
    <field name="source">google_workspace</field>
    <description>GWS: $(events.name) by $(actor.email)</description>
    <options>no_full_log</options>
  </rule>

  <!-- ── Login events ─────────────────────────────────────────────────────── -->
  <rule id="100401" level="5">
    <if_sid>100400</if_sid>
    <field name="events.name">login_failure</field>
    <description>GWS: Login failure for $(actor.email) from $(ip_address)</description>
  </rule>

  <rule id="100402" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100401</if_matched_sid>
    <same_field>actor.email</same_field>
    <description>GWS: Brute force - 5+ login failures for $(actor.email) in 5 minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100403" level="10">
    <if_sid>100400</if_sid>
    <field name="events.name">suspicious_login</field>
    <description>GWS: Suspicious login flagged for $(actor.email) from $(ip_address)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100404" level="12">
    <if_sid>100400</if_sid>
    <field name="events.name">suspicious_login_less_secure_app</field>
    <description>GWS: Login from less-secure app for $(actor.email) - legacy auth abuse</description>
    <mitre>
      <id>T1078.004</id>
    </mitre>
  </rule>

  <!-- ── 2SV/MFA changes ──────────────────────────────────────────────────── -->
  <rule id="100410" level="8">
    <if_sid>100400</if_sid>
    <field name="events.name">2sv_disable</field>
    <description>GWS: 2SV/MFA disabled for $(actor.email)</description>
    <mitre>
      <id>T1556.006</id>
    </mitre>
  </rule>

  <rule id="100411" level="10">
    <if_sid>100400</if_sid>
    <field name="events.name">2sv_enroll</field>
    <field name="events.parameters.method_type">ANDROID_WORLDWIDE</field>
    <description>GWS: New 2SV factor enrolled for $(actor.email) from unusual device</description>
  </rule>

  <!-- ── Admin Console actions ────────────────────────────────────────────── -->
  <rule id="100420" level="10">
    <if_sid>100400</if_sid>
    <field name="events.name">CHANGE_USER_PASSWORD</field>
    <description>GWS: Admin password reset for $(events.parameters.USER_EMAIL) by $(actor.email)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <rule id="100421" level="10">
    <if_sid>100400</if_sid>
    <field name="events.name">GRANT_ADMIN_PRIVILEGE</field>
    <description>GWS: Admin privilege granted to $(events.parameters.USER_EMAIL) by $(actor.email)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>privilege_escalation,</group>
  </rule>

  <rule id="100422" level="12">
    <if_sid>100400</if_sid>
    <field name="events.name">CREATE_ROLE</field>
    <description>GWS: Custom admin role created by $(actor.email) - $(events.parameters.ROLE_NAME)</description>
  </rule>

  <!-- ── Drive (data) events ──────────────────────────────────────────────── -->
  <rule id="100430" level="7">
    <if_sid>100400</if_sid>
    <field name="events.name">change_user_access</field>
    <field name="events.parameters.visibility">people_with_link</field>
    <description>GWS: Drive sharing changed to anyone-with-link by $(actor.email)</description>
    <mitre>
      <id>T1567.002</id>
    </mitre>
  </rule>

  <rule id="100431" level="10">
    <if_sid>100400</if_sid>
    <field name="events.name">change_user_access</field>
    <field name="events.parameters.visibility">public</field>
    <description>GWS: Drive doc made PUBLIC by $(actor.email) - $(events.parameters.doc_title)</description>
    <mitre>
      <id>T1567.002</id>
    </mitre>
    <group>data_exposure,</group>
  </rule>

  <rule id="100432" level="10" frequency="50" timeframe="3600">
    <if_sid>100400</if_sid>
    <field name="events.name">download</field>
    <same_field>actor.email</same_field>
    <description>GWS: Bulk download - 50+ Drive downloads by $(actor.email) in 1 hour</description>
    <mitre>
      <id>T1530</id>
    </mitre>
    <group>bulk_download,</group>
  </rule>

  <!-- ── DLP events (from GWS native DLP) ─────────────────────────────────── -->
  <rule id="100440" level="11">
    <if_sid>100400</if_sid>
    <field name="events.name">RULE_TRIGGERED</field>
    <field name="events.parameters.RULE_TYPE">dlp</field>
    <description>GWS DLP: Policy violation by $(actor.email) - $(events.parameters.RULE_NAME)</description>
    <group>dlp,</group>
  </rule>

  <!-- ── OAuth token grants ───────────────────────────────────────────────── -->
  <rule id="100450" level="8">
    <if_sid>100400</if_sid>
    <field name="events.name">authorize</field>
    <field name="events.parameters.scope">drive|mail|admin</field>
    <description>GWS: Sensitive OAuth scope granted by $(actor.email) - $(events.parameters.app_name)</description>
    <mitre>
      <id>T1550.001</id>
    </mitre>
  </rule>

  <!-- ── Email forwarding (BEC indicator) ──────────────────────────────────── -->
  <rule id="100460" level="11">
    <if_sid>100400</if_sid>
    <field name="events.name">email_forwarding_out_of_domain</field>
    <description>GWS: External email forwarding rule created by $(actor.email) - BEC indicator</description>
    <mitre>
      <id>T1114.003</id>
    </mitre>
    <group>email_forwarding,bec,</group>
  </rule>

</group>
