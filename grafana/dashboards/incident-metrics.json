{
  "annotations": {"list": []}, "editable": true, "id": null, "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "id": 1,
      "title": "MTTR Trend (30/60/90 day moving average)",
      "type": "timeseries",
      "targets": [
        {"expr": "avg_over_time(corpsec_thehive_mttr_seconds[30d])", "legendFormat": "30d MA", "refId": "A"},
        {"expr": "avg_over_time(corpsec_thehive_mttr_seconds[60d])", "legendFormat": "60d MA", "refId": "B"},
        {"expr": "avg_over_time(corpsec_thehive_mttr_seconds[90d])", "legendFormat": "90d MA", "refId": "C"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "id": 2,
      "title": "Cases by Severity (weekly)",
      "type": "barchart",
      "targets": [{"expr": "sum by (severity) (increase(corpsec_thehive_cases_total[1w]))", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "id": 3,
      "title": "SLA Compliance",
      "type": "gauge",
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "targets": [{"expr": "corpsec_thehive_sla_compliance_percent", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "id": 4,
      "title": "Incident Categories",
      "type": "piechart",
      "targets": [{"expr": "sum by (category) (corpsec_thehive_cases_total)", "legendFormat": "{{ category }}", "refId": "A"}]
    }
  ],
  "refresh": "5m", "schemaVersion": 39, "tags": ["soc", "ir"],
  "time": {"from": "now-30d", "to": "now"},
  "title": "Incident Metrics", "uid": "incident-metrics", "version": 1
}
