# ══════════════════════════════════════════════════════════════════════════════
# corpsec-ops-platform — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# cp .env.example .env
# NEVER commit .env to git. Excluded via .gitignore.
# Replace every CHANGE_ME with a strong unique value (use 1Password generator).
# ══════════════════════════════════════════════════════════════════════════════

# ── Project ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=corpsec
TZ=America/Vancouver
PUBLIC_HOSTNAME=corpsec.local

# ── Wazuh ────────────────────────────────────────────────────────────────────
WAZUH_VERSION=4.9.2
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_wazuh_api_min_8_chars
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME_wazuh_indexer_min_12_chars_with_special
WAZUH_CLUSTER_KEY=CHANGE_ME_wazuh_cluster_key_32_chars_hex
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_dashboard_pwd

# ── TheHive + Cortex ─────────────────────────────────────────────────────────
THEHIVE_VERSION=5.4
CORTEX_VERSION=3.1.8
CASSANDRA_VERSION=4.1
ELASTICSEARCH_VERSION=7.17.24
THEHIVE_SECRET=CHANGE_ME_thehive_application_secret_min_64_chars_random_alphanumeric
CORTEX_SECRET=CHANGE_ME_cortex_application_secret_min_64_chars_random_alphanumeric
CORTEX_API_KEY=CHANGE_ME_cortex_api_key_generated_after_first_login

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_VERSION=11.5.2
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
GF_SECURITY_SECRET_KEY=CHANGE_ME_grafana_secret_key_32_chars
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Okta
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=CHANGE_ME_okta_oidc_client_id
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=CHANGE_ME_okta_oidc_client_secret
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://your-org.okta.com/oauth2/default/v1/authorize
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://your-org.okta.com/oauth2/default/v1/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://your-org.okta.com/oauth2/default/v1/userinfo

# ── Prometheus / Loki / Alertmanager ─────────────────────────────────────────
PROMETHEUS_VERSION=v2.54.0
LOKI_VERSION=3.4.2
PROMTAIL_VERSION=3.4.2
ALERTMANAGER_VERSION=v0.27.0
ALERTMANAGER_SLACK_WEBHOOK=https://hooks.slack.com/services/CHANGE_ME

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_VERSION=1.73.1
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key_32_chars_random
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_basic_auth

# ── GoPhish ──────────────────────────────────────────────────────────────────
GOPHISH_VERSION=0.12.1
GOPHISH_ADMIN_USER=admin
GOPHISH_ADMIN_PASSWORD=CHANGE_ME_gophish_admin

# ── Real Production Tool API Credentials ─────────────────────────────────────
# Populated after trial signups (Day 0)

# Okta Developer Free
OKTA_ORG_URL=https://dev-XXXXXX.okta.com
OKTA_API_TOKEN=CHANGE_ME_okta_api_token_from_admin_console
OKTA_OIDC_CLIENT_ID=CHANGE_ME_okta_oidc_client_id
OKTA_OIDC_CLIENT_SECRET=CHANGE_ME_okta_oidc_client_secret

# CrowdStrike Falcon (14-day trial)
CROWDSTRIKE_CLIENT_ID=CHANGE_ME_falcon_api_client_id
CROWDSTRIKE_CLIENT_SECRET=CHANGE_ME_falcon_api_client_secret
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# Google Workspace (14-day trial)
GWS_DOMAIN=your-trial-domain.com
GWS_SERVICE_ACCOUNT_FILE=/run/secrets/gws-service-account.json
GWS_DELEGATED_USER=admin@your-trial-domain.com

# 1Password Business (14-day trial)
OP_SERVICE_ACCOUNT_TOKEN=CHANGE_ME_1password_service_account_token
OP_VAULT=SOC-Shared
OP_AUDIT_LOG_API_KEY=CHANGE_ME_1password_audit_api_key

# Microsoft Intune (30-day trial)
INTUNE_TENANT_ID=CHANGE_ME_azure_tenant_id_uuid
INTUNE_CLIENT_ID=CHANGE_ME_app_registration_client_id
INTUNE_CLIENT_SECRET=CHANGE_ME_app_registration_secret
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
